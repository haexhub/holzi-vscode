{
  "name": "holzi-vscode",
  "displayName": "Holzi",
  "description": "Holzi AI assistant in VS Code",
  "version": "0.1.2",
  "packageManager": "pnpm@10.33.2",
  "publisher": "haex",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/haexhub/holzi-vscode"
  },
  "bugs": {
    "url": "https://github.com/haexhub/holzi-vscode/issues"
  },
  "homepage": "https://github.com/haexhub/holzi-vscode#readme",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI"],
  "keywords": ["ai", "chat", "assistant", "holzi"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "holzi.openChat", "title": "Holzi: Open Chat" },
      { "command": "holzi.configure", "title": "Holzi: Configure Server" },
      { "command": "holzi.login", "title": "Holzi: Sign In" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "holzi-sidebar",
          "title": "Holzi",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "holzi-sidebar": [
        {
          "type": "webview",
          "id": "holzi.sidebarView",
          "name": "Chats"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "holzi.chat",
        "fullName": "Holzi",
        "name": "holzi",
        "description": "Holzi AI Assistant",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "Holzi",
      "properties": {
        "holzi.host": {
          "type": "string",
          "default": "https://holzi.haex.cloud",
          "description": "Holzi server URL"
        },
        "holzi.token": {
          "type": "string",
          "description": "Auth token (Bearer)",
          "isSensitive": true
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "compile:webview": "tsc -p tsconfig.webview.json",
    "test": "vitest run",
    "mock-server": "ts-node mock-server/index.ts",
    "package": "vsce package"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
